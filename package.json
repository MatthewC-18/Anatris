{
  "name": "fisio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build-anatomy": "tsx --tsconfig tsconfig.scripts.json scripts/build-anatomy-index.ts",
    "audit-data": "tsx --tsconfig tsconfig.scripts.json scripts/audit-clinical-data.mts",
    "neuro-plate": "tsx --tsconfig tsconfig.scripts.json scripts/render-neuro-plate.mts",
    "neuro-plate-box": "tsx --tsconfig tsconfig.scripts.json scripts/measure-neuro-plate.mts",
    "gen-pwa-icons": "node scripts/gen-pwa-icons.mjs",
    "gen-og-image": "node scripts/gen-og-image.mjs",
    "triage-citations": "tsx --tsconfig tsconfig.scripts.json scripts/triage-citations.mts",
    "build-premium-content": "tsx --tsconfig tsconfig.scripts.json scripts/build-premium-content.mts",
    "gen-sitemap": "tsx --tsconfig tsconfig.scripts.json scripts/gen-sitemap.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "optimize-rig": "node scripts/decimate-glb.mjs rig-src/cuerpo-rig.glb public/cuerpo-rig.opt.glb 0.4 --no-quantize",
    "optimize-model": "node scripts/decimate-glb.mjs rig-src/modelo-opt.glb public/modelo-opt.dec.glb 0.3"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.108.2",
    "posthog-js": "^1.407.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.4.1",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "meshoptimizer": "^1.1.1",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
